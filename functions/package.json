{
  "name": "accountability-buddy-relay",
  "description": "Stateless relay that forwards sealed messages to Firebase Cloud Messaging",
  "private": true,
  "type": "module",
  "main": "lib/src/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint .",
    "test": "tsc && node --test \"lib/test/**/*.test.js\"",
    "check": "npm run lint && npm test"
  },
  "dependencies": {
    "firebase-admin": "14.5.0",
    "firebase-functions": "7.4.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  }
}
